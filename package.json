{
  "name": "daaproject",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "realtime:server": "node scripts/realtime-server.mjs",
    "db:push": "node scripts/convex-db-push.mjs",
    "db:pull": "node scripts/convex-db-pull.mjs",
    "pretest": "node scripts/sync-quiz-data.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "test:multiplayer": "node --env-file=.env.local scripts/check-multiplayer.mjs",
    "test:doors-online": "node --env-file=.env.local scripts/check-shared-doors.mjs",
    "test:characters": "node --env-file=.env.local scripts/check-characters.mjs",
    "test:chat": "node --env-file=.env.local scripts/check-chat.mjs",
    "test:emotes": "node --env-file=.env.local scripts/check-emotes.mjs",
    "test:quiz-lobby": "node --env-file=.env.local scripts/check-quiz-lobby.mjs",
    "test:statistics": "node --env-file=.env.local scripts/check-quiz-statistics.mjs",
    "validate:quiz": "node scripts/sync-quiz-data.mjs --validate-only",
    "audit:quiz": "node scripts/audit-quiz-quality.mjs",
    "analyze:quick-quiz": "node tools/quiz-review/scripts/analyze-quick-quiz.mjs",
    "sync:quiz": "node scripts/sync-quiz-data.mjs",
    "predev": "node scripts/sync-quiz-data.mjs && node scripts/sync-director-investigation.mjs",
    "dev": "vite",
    "convex": "convex dev --local-backend-version precompiled-2026-09-21-0cf49cb",
    "preconvex": "node scripts/sync-quiz-data.mjs && node scripts/sync-door-definitions.mjs && node scripts/sync-npc-collectible-spawns.mjs && node scripts/sync-director-investigation.mjs",
    "prebuild": "node scripts/sync-quiz-data.mjs && node scripts/sync-door-definitions.mjs && node scripts/sync-npc-collectible-spawns.mjs && node scripts/sync-director-investigation.mjs",
    "build": "vite build",
    "prebuild:test": "npm run prebuild",
    "build:test": "vite build --config vite.test.config.js --mode test",
    "preview:test": "vite preview --config vite.test.config.js --mode test",
    "check:test": "node scripts/check-pvp-test.mjs",
    "deploy:prod": "npx vercel@latest --prod",
    "preview": "vite preview"
  },
  "dependencies": {
    "convex": "^1.45.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "vite": "^8.3.0",
    "ws": "^8.21.0"
  }
}
