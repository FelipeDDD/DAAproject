ght="351.5622253417969" isSetByUser="true"/><one:OEChildren><one:OE authorResolutionID="&lt;resolutionId provider=&quot;AD&quot; hash=&quot;l5qDJ7ap36alcit50Gc32A==&quot;&gt;&lt;localId O365id=&quot;S::1932206171@bildung.daa.de::f24d8c2f-c43b-4db6-a42d-c5c16635adfa&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;AD&quot; hash=&quot;l5qDJ7ap36alcit50Gc32A==&quot;&gt;&lt;localId O365id=&quot;S::1932206171@bildung.daa.de::f24d8c2f-c43b-4db6-a42d-c5c16635adfa&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-11T12:34:55.000Z" lastModifiedTime="2026-09-11T12:39:51.000Z" objectID="{1366351A-383A-4E56-9203-FAB5DFA8349E}{17}{B0}" alignment="left" quickStyleIndex="1" style="font-family:Calibri;font-size:24.0pt"><one:T><![CDATA[Seit 2020 wird in den neugeordneten vier IT-Berufen ausgebildet. Die Ausbildungsdauer wurde bei drei Jahren belassen, Verkürzungen sind je nach Anrechnung anerkannter Bildungsgänge möglich. Auch eine Verlängerung und eine Ausbildung in Teilzeit sind bei besonderer Begründung möglich.]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;AD&quot; hash=&quot;l5qDJ7ap36alcit50Gc32A==&quot;&gt;&lt;localId O365id=&quot;S::1932206171@bildung.daa.de::f24d8c2f-c43b-4db6-a42d-c5c16635adfa&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;AD&quot; hash=&quot;l5qDJ7ap36alcit50Gc32A==&quot;&gt;&lt;localId O365id=&quot;S::1932206171@bildung.daa.de::f24d8c2f-c43b-4db6-a42d-c5c16635adfa&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-11T12:39:51.000Z" lastModifiedTime="2026-09-11T12:39:51.000Z" objectID="{1366351A-383A-4E56-9203-FAB5DFA8349E}{21}{B0}" alignment="left" quickStyleIndex="1" style="font-family:Calibri;font-size:24.0pt"><one:T><![CDATA[]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;AD&quot; hash=&quot;l5qDJ7ap36alcit50Gc32A==&quot;&gt;&lt;localId O365id=&quot;S::1932206171@bildung.daa.de::f24d8c2f-c43b-4db6-a42d-c5c16635adfa&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;AD&quot; hash=&quot;l5qDJ7ap36alcit50Gc32A==&quot;&gt;&lt;localId O365id=&quot;S::1932206171@bildung.daa.de::f24d8c2f-c43b-4db6-a42d-c5c16635adfa&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-11T12:38:54.000Z" lastModifiedTime="2026-09-11T12:39:51.000Z" objectID="{1366351A-383A-4E56-9203-FAB5DFA8349E}{24}{B0}" alignment="left" quickStyleIndex="1" style="font-family:Calibri;font-size:24.0pt"><one:T><![CDATA[IT-Systemelektroniker werden so ausgebildet, dass sie die IT-Infrastruktur herstellen und betreuen können. Zwei kaufmännische IT-Berufe werden insbesondere von ITK-Dienstleistungsunternehmen (ITK: Informations- und Telekommunikation) nachgefragt, um Kundenwünsche zu analysieren, Kunden zu beraten, kundengerecht ITK-Produkte zu liefern, einzuführen und eventuell auch zu betreuen. Am meisten werden die Fachinformatiker nachgefragt, da ein hoher Bedarf an Systemintegration, Entwicklern für IT-Anwendungen und Vernetzung besteht. Wegen der vielfältigen Aufgaben und Einsatzbereiche werden vier Fachrichtungen unterschieden. Neu sind die Fachrichtungen „Digitale Vernetzung“ sowie „Daten und Prozessanalyse“ hinzugekommen, da hier zukünftig hoher Bedarf erwartet wird.]]></one:T></one:OE></one:OEChildren></one:Outline><one:Image lastModifiedTime="2026-09-11T12:40:48.000Z" objectID="{1366351A-383A-4E56-9203-FAB5DFA8349E}{27}{B0}"><one:Position x="36.0" y="467.4822082519531" z="1"/><one:Size width="1106.400024414062" height="591.0001220703124" isSetByUser="true"/><one:CallbackID callbackID="{1366351A-383A-4E56-9203-FAB5DFA8349E}{27}{B0}"/><one:OCRData lang="de"><one:OCRText><![CDATA[Berufsgruppe IT-Berufe 
Fachrichtungen 
Ausbildungsdauer 
Prüfungsform der IHK 
Rechtsgrundlagen 
Neue IT-Berufe 
IT-Systemelektroniker, Kaufleute für IT-Systemmanagement, Kaufleute 
für Digitalisierungsmanagement und Fachinformatiker bilden die 
Berufsgruppe „IT-Berufe". Sie erlangen gemeinsame Kernqualifika- 
tionen und spezifische Berufsqualifikationen. 
Der Fachinformatiker wird in vier Fachrichtungen unterschieden und 
ausgebildet. 
3 Jahre, Verkürzung und Verlängerung auf Antrag bei Vorliegen 
gegebener Voraussetzungen möglich, vgl. SS 7, 8, 45 BBiG 
Gestreckte Prüfung in drei Teilen: 
Teil 1 schriftlich, etwa nach 15 Monaten, bezogen auf die Lernfelder 1 
bis 6 
Teil 2 schriftlich, ca. 3 Monate vor Ausbildungsende 
Teil 3 mündlich, mit Projektarbeit, zum Ausbildungsende 
Berufsbildungsgesetz, BBiG, vgl. www.gesetze-im-internet.de 
Ausbildungsverordnung, siehe www.bibb.de 
Rahmenlehrpläne, siehe www.km k.org ]]></one:OCRText><one:OCRToken startPos="0" region="0" line="0" x="37.79999923706054" y="68.99999237060547" width="146.3999938964844" height="22.79999923706055"/><one:OCRToken startPos="13" region="0" line="0" x="192.5999908447266" y="68.99999237060547" width="98.4000015258789" height="17.99999809265137"/><one:OCRToken startPos="24" region="0" line="1" x="37.79999923706054" y="193.7999725341797" width="163.7999877929687" height="23.39999961853027"/><one:OCRToken startPos="40" region="0" line="2" x="35.99999618530273" y="262.199981689453" width="196.8000030517578" height="23.99999809265137"/><one:OCRToken startPos="58" region="0" line="3" x="37.79999923706054" y="330.6000061035156" width="146.9999847412109" height="23.39999961853027"/><one:OCRToken startPos="71" region="0" line="3" x="193.1999816894531" y="331.199981689453" width="35.99999618530273" height="17.99999809265137"/><one:OCRToken startPos="75" region="0" line="3" x="236.3999786376953" y="332.9999694824219" width="37.19999313354492" height="15.60000038146973"/><one:OCRToken startPos="80" region="0" line="4" x="37.79999923706054" y="485.9999694824219" width="193.7999725341797" height="22.79999923706055"/><one:OCRToken startPos="98" region="1" line="5" x="476.9999694824219" y="31.79999732971191" width="53.39999771118164" height="16.19999885559082"/><one:OCRToken startPos="103" region="1" line="5" x="538.7999877929687" y="29.99999618530273" width="98.4000015258789" height="17.99999809265137"/><one:OCRToken startPos="114" region="1" line="6" x="346.199981689453" y="68.99999237060547" width="223.7999877929687" height="22.19999885559082"/><one:OCRToken startPos="137" region="1" line="6" x="578.9999389648437" y="69.59999847412109" width="95.39999389648437" height="17.39999961853027"/><one:OCRToken startPos="147" region="1" line="6" x="681.0" y="68.99999237060547" width="29.99999618530273" height="17.99999809265137"/><one:OCRToken startPos="151" region="1" line="6" x="718.7999267