# Optional: copy to .env.test.local IN THIS DIRECTORY, not the repository root.
# This file has no secrets. Values prefixed VITE_ are public browser settings.
# Default: one tunnel exposes preview:test, which proxies both backend services.
VITE_QUICK_TUNNEL=true
VITE_REALTIME_URL=/pvp-realtime

# Server-side preview targets; loopback only. These do not enter the build.
PVP_TEST_CONVEX_TARGET=http://127.0.0.1:3210
PVP_TEST_REALTIME_TARGET=http://127.0.0.1:8787
# Optional exact hostname for a named tunnel, without scheme, port or wildcard.
# PVP_TEST_ALLOWED_HOST=pvp-test.example.com

# For a separate public relay, replace VITE_REALTIME_URL with its WSS endpoint:
# VITE_REALTIME_URL=wss://relay.example.com/pvp-realtime
# For static hosting with separate public endpoints, also set:
# VITE_QUICK_TUNNEL=false
# VITE_CONVEX_URL=https://convex-test.example.com
# Both URLs must reach the SAME local backend/relay used by the trusted bridge.
# A cloud Convex URL alone is insufficient: the existing bridge is local-only.
